{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastbull-ticker.local/protocol/v1/items.schema.json",
  "title": "items",
  "description": "items 順序語意為舊到新（published_at_ms 非遞減），由額外檢查負責，schema 無法表達。 整則所有 item 都合法才接受。",
  "type": "object",
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "const": "items" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "item.schema.json" }
    }
  },
  "required": ["v", "type", "items"],
  "additionalProperties": false
}
