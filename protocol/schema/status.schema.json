{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastbull-ticker.local/protocol/v1/status.schema.json",
  "title": "status",
  "description": "連線健康度，兼作心跳（至少每 30 秒一則，退避期間亦然）。message 在 ok 時可為空字串。",
  "type": "object",
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "const": "status" },
    "source": { "type": "string", "minLength": 1 },
    "state": { "enum": ["ok", "error"] },
    "message": { "type": "string" }
  },
  "required": ["v", "type", "source", "state", "message"],
  "additionalProperties": false
}
